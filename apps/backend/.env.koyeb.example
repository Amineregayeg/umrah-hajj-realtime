# ========================================
# Koyeb Staging Environment Configuration
# ========================================
#
# Copy this file and configure for your Koyeb deployment.
# Set these variables in Koyeb dashboard under "Environment Variables"
#
# Documentation: docs/API_ENV_VARS.md
# Deployment Guide: docs/DEPLOY_KOYEB.md

# ========================================
# Core Application
# ========================================

# Runtime environment (REQUIRED)
NODE_ENV=production

# Server port (Koyeb injects automatically)
PORT=8000

# ========================================
# Security & Authentication
# ========================================

# Authentication mode: mock | supabase | jwt
# Use 'mock' for staging/testing, 'supabase' for production
AUTH_MODE=mock

# Supabase JWKS endpoint (REQUIRED when AUTH_MODE=supabase)
# Get this from your Supabase project: Settings → API → JWT Settings
# SUPABASE_JWT_JWKS=https://YOUR_PROJECT.supabase.co/auth/v1/jwks

# ========================================
# CORS & WebSocket Origins
# ========================================

# Comma-separated list of allowed CORS origins (REQUIRED)
# MUST match your frontend domain exactly (including protocol, no trailing slash)
CORS_ORIGINS=https://YOUR_APP_NAME.koyeb.app
ALLOWED_ORIGINS=https://YOUR_APP_NAME.koyeb.app

# WebSocket origin (REQUIRED, single origin only)
# CRITICAL: WebSocket connections rejected if origin doesn't match exactly
WS_ORIGIN=https://YOUR_APP_NAME.koyeb.app

# ========================================
# Database
# ========================================

# PostgreSQL connection string (REQUIRED)
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?sslmode=require
# Get this from Neon, Supabase, or your Postgres provider
# ALWAYS include ?sslmode=require for remote databases
DATABASE_URL=postgresql://REPLACE_USER:REPLACE_PASSWORD@REPLACE_HOST.neon.tech:5432/REPLACE_DATABASE?sslmode=require

# ========================================
# WebSocket & Protocol
# ========================================

# Enable MessagePack binary protocol for WebSockets
# false = JSON text frames (default, easier debugging)
# true = Binary MessagePack frames (smaller payload, faster)
ENABLE_MSGPACK=false
WS_MSGPACK_ENABLED=false

# ========================================
# Prayer & Qibla Configuration
# ========================================

# Prayer time calculation method
# Options: UmmAlQura | ISNA | MWL | Makkah | Egypt | Tehran | Karachi
# Recommended: UmmAlQura (for Mecca/Medina region)
PRAYER_DEFAULT_METHOD=UmmAlQura

# ========================================
# Logging & Monitoring
# ========================================

# Enable security audit logging
# Logs authentication attempts, voice token issuance, admin actions
AUDIT_LOGGING_ENABLED=true

# Minimum log level: error | warn | info | debug | verbose
# Recommendation: 'info' for staging, 'warn' or 'error' for production
LOG_LEVEL=info

# ========================================
# Rate Limiting (AI Voice Tokens)
# ========================================

# Rate limit window in milliseconds
# Default: 60000 (1 minute)
RATE_LIMIT_WINDOW=60000

# Maximum requests per window per user
# Default: 5 requests/minute (burst: 10)
RATE_LIMIT_MAX=5

# ========================================
# AI & OpenAI Integration (Optional)
# ========================================

# OpenAI API key (REQUIRED if using AI endpoints)
# Get this from https://platform.openai.com/api-keys
# NEVER commit this to version control
# OPENAI_API_KEY=sk-proj-...

# OpenAI organization ID (optional)
# For organization-level billing/usage tracking
# OPENAI_ORG_ID=org-...

# ========================================
# INSTRUCTIONS
# ========================================
#
# 1. Replace ALL placeholders:
#    - YOUR_APP_NAME → your actual Koyeb app name
#    - REPLACE_USER, REPLACE_PASSWORD, REPLACE_HOST, REPLACE_DATABASE → your Neon/Postgres credentials
#    - YOUR_PROJECT → your Supabase project ID (if using Supabase auth)
#
# 2. Set these in Koyeb dashboard:
#    - Navigate to your service → Settings → Environment Variables
#    - Click "Add Variable" for each variable
#    - Paste name and value
#    - Click "Update Service" to apply
#
# 3. Validation:
#    - App will not start if critical variables are missing
#    - Check Koyeb logs for validation errors
#
# 4. Security:
#    - NEVER commit .env files with real credentials
#    - Use Koyeb's environment variable storage (encrypted at rest)
#    - Rotate DATABASE_URL and API keys periodically
#
# ========================================
# FURTHER READING
# ========================================
#
# - Full Environment Variable Reference: docs/API_ENV_VARS.md
# - Deployment Guide: docs/DEPLOY_KOYEB.md
# - Unity Integration: docs/UNITY_INTEGRATION_GUIDE.md
# - Security Headers: docs/SECURITY_HEADERS.md
