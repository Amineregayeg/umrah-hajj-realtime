{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "skipLibCheck": true,
    "skipDefaultLibCheck": true
  },
  "exclude": [
    "node_modules",
    "test",
    "dist",
    "**/*.spec.ts",
    "**/*.test.ts",
    "**/*-test-runner.ts",
    "**/*-validator.ts",
    "**/test/**",
    "**/__tests__/**",
    "**/__mocks__/**"
  ]
}
