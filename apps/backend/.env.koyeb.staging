# ========================================
# Koyeb Environment Variables - STAGING
# ========================================
# Copy these to Koyeb Web Service Environment Variables
# For mock auth (quick staging without Supabase)
# ========================================

# Node Environment
NODE_ENV=production

# Port (Koyeb will inject the actual port, but set default)
PORT=3000

# Database (Neon PostgreSQL)
# Replace with your actual Neon connection string
DATABASE_URL=postgresql://neondb_owner:npg_cX37PBfohMqZ@ep-summer-cherry-a1mtg9rw-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Authentication Mode - MOCK for staging
# This allows Unity/clients to connect with any token (e.g., ?token=MOCK)
# Switch to "supabase" later when you have a Supabase project
AUTH_MODE=mock

# CORS Origins (update with your Koyeb app URL after deployment)
# Format: https://your-app-name.koyeb.app
ALLOWED_ORIGINS=https://umrah-hajj-backend.koyeb.app,http://localhost:3000

# WebSocket Origin (same as your Koyeb app URL)
WS_ORIGIN=https://umrah-hajj-backend.koyeb.app

# MessagePack (disabled for easier debugging in staging)
WS_MSGPACK_ENABLED=false
ENABLE_MSGPACK=false

# Prayer Times Configuration
PRAYER_DEFAULT_METHOD=4

# Optional: OpenAI API Key (add later when you need /ai/voice/token)
# OPENAI_API_KEY=sk-...

# Optional: Supabase (only if using AUTH_MODE=supabase)
# SUPABASE_JWT_JWKS=https://your-project.supabase.co/auth/v1/jwks
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=eyJ...

# ========================================
# IMPORTANT NOTES:
# ========================================
# 1. Update ALLOWED_ORIGINS and WS_ORIGIN with your actual Koyeb URL after deployment
# 2. Never commit this file with real credentials to git
# 3. In Koyeb, paste each variable WITHOUT quotes
# 4. To switch to real auth later, just change AUTH_MODE=supabase and add SUPABASE_JWT_JWKS
# ========================================
